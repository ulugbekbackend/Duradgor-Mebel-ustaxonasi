# Duradgor Mebel — muhit sozlamalari (python-decouple shu faylni o'qiydi)
# DEBUG=False bo'lsa SECRET_KEY majburiy. Yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Ma'lumotlar bazasi — PostgreSQL. docker compose ham DB konteynerini shu DB_NAME/DB_USER/DB_PASSWORD
# bilan yaratadi (DB_ENGINE/DB_HOST/DB_PORT ni docker o'zi beradi).
# Lokal tez ishga tushirish uchun SQLite: quyidagi ikki qiymatni almashtiring (qolgan DB_* e'tiborsiz qoladi)
#   DB_ENGINE=django.db.backends.sqlite3
#   DB_NAME=db.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=duradgor
DB_USER=duradgor
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS — faqat kerakli frontend domenlari (Vite dev: 3000-port)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost

# Nginx ortida ishlasa 1 (docker compose o'zi beradi), to'g'ridan-to'g'ri bo'lsa 0
NUM_PROXIES=0

# Telegram bot (yangi buyurtma xabari)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rasm optimallashtirish (Pillow → WebP)
CONVERT_MEDIA_TO_WEBP=True
WEBP_QUALITY=82

# DEBUG=False bo'lganda: HTTPS sozlangan bo'lsa True (deploy/nginx.https.conf), faqat HTTP bo'lsa False
SECURE_SSL_REDIRECT=False
